{
  "expo": {
    "name": "AgroVision",
    "slug": "agrovision-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/app/assets/onboarding.png",
    "userInterfaceStyle": "light",
    "scheme": "agrovision",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/app/assets/onboarding.png",
      "resizeMode": "cover",
      "backgroundColor": "#1B4332"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.agrovision.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/app/assets/onboarding.png",
        "backgroundColor": "#1B4332"
      },
      "package": "com.agrovision.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/app/assets/contact_us.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "router": {
      "root": "src"
    }
  }
}
