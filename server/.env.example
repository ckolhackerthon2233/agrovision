# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agrovision?schema=public"

# Port the API listens on.
PORT=4000

# Comma-free single origin or "*" for dev. Lock this down in production.
CORS_ORIGIN=*

# Optional. When set, the API verifies the Clerk session token sent as
# `Authorization: Bearer <token>`. When empty, the API runs in DEV mode and
# trusts the `x-user-id` header instead (handy for Expo Go where Clerk is stubbed).
CLERK_SECRET_KEY=

# ── Automation toolkit (all OPTIONAL — empty = dry-run that logs instead of sends) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AgroVision <no-reply@agrovision.app>

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

REMINDER_TEST_PHONE=
